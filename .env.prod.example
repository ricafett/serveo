APP_NAME=Serveo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=8080
APP_LOCALE=pt-PT
APP_FALLBACK_LOCALE=en
# Timezone — single source of truth for all date/time behaviour
# Applied to: Laravel app, PHP system clock, PostgreSQL sessions, all containers
APP_TIMEZONE=Europe/Lisbon

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_STACK=daily

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serveo_prod
DB_USERNAME=serveo_prod
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=525600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Docker volume paths
# Set to an absolute host path to use a bind mount
# (e.g. /mnt/user/appdata/serveo/postgres)
# Leave commented out to use the default relative paths
# (./data/postgres, ./data/redis, ./data/storage)
#POSTGRES_DATA_PATH=/mnt/user/appdata/serveo/postgres
#REDIS_DATA_PATH=/mnt/user/appdata/serveo/redis
#STORAGE_DATA_PATH=/mnt/user/appdata/serveo/storage

# Serveo printing
SERVEO_PRINT_AGENT_URL=
SERVEO_PRINT_AGENT_TOKEN=
