# Build-time environment for Docker image construction.
# Used ONLY during `composer install` in the Dockerfile.
# Deleted before the image is finalized — never reaches production.
# The entrypoint replaces this with .env.example at container start.
#
# Values chosen to let artisan commands boot without a real database,
# Redis, or other external services during the Docker build.

APP_NAME=Serveo
APP_ENV=production
APP_KEY=base64:WoU3n7OLq3LJ7KQ0RpXOkmEoNfYWT4+NPFNhhhpHbXA=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
