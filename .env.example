APP_NAME=Serveo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=serveo
DB_USERNAME=serveo
DB_PASSWORD=serveo

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Docker volume paths
# Set to an absolute host path to use a bind mount (e.g. /mnt/user/appdata/serveo/postgres)
# Leave commented out to use the default relative path (./data/postgres, ./data/redis)
#POSTGRES_DATA_PATH=/mnt/user/appdata/serveo/postgres
#REDIS_DATA_PATH=/mnt/user/appdata/serveo/redis

# Serveo printing
SERVEO_PRINT_AGENT_URL=
SERVEO_PRINT_AGENT_TOKEN=
